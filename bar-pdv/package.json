{
  "name": "bar-pdv",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "setup": "pnpm install && pnpm --filter @bar/shared build && pnpm --filter @bar/api prisma:generate",
    "db:up": "docker compose up -d",
    "db:migrate": "pnpm --filter @bar/api prisma:migrate",
    "db:seed": "pnpm --filter @bar/api prisma:seed",
    "dev:shared": "pnpm --filter @bar/shared dev",
    "dev:api": "pnpm --filter @bar/api dev",
    "dev:web": "pnpm --filter @bar/web dev",
    "dev:mobile": "pnpm --filter @bar/mobile start"
  }
}
